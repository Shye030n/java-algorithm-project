/*
1.
가로선 / 세로선 / 대각선 / 접점 => 개수 확인
n n n n (n) 개인 경우 = (Switch문/If/Else문) > 숫자 판독

2.
숫자는 2차원 배열로 정의되어 주어짐.
*/

int[][] arr = {
   {1,2,3},
   {4,5,6},
};

/*
arr.length      -> 행(row)의 개수 = 2
arr[0].length   -> 0번 행의 칸 개수 = 3
arr[1].length   -> 1번 행의 칸 개수 = 3
*/

// 이중 for문으로 2차원 배열 순회
for (int i = 0; i < arr.length; i++) {
   //세로선 (i, i+1, i+2 가 모두 1인 경우를 세로선이라 하겠다.)
   for (int j = 0; arr[i].length; j++) { // 여기서 arr[i]은 한 행(row)을 뜻함.
      //가로선 (j, j+1, j+2 가 모두 1인 경우를 가로선이라 하겠다.)
      //상향 대각선(i와 j, i+1과 j+1, i+2와 j+2 가 모두 1인 경우를 상향 대각선이라 하겠다.
      //하향 대각선(i와 j, i-1과 j-1, i-2와 j-2 가 모두 1인 경우를 하향 대각선이라 하겠다.
   }
}


/*
가로선을 정의하고
가로선 : 한 행에서 연속적으로 1인 경우
*/
